+'use strict';
+
+const { generateId, createCustomGenerator } = require('../src/utils/idGenerator');
+
+describe('idGenerator', () => {
+
+  describe('generateId()', () => {
+
+    it('should return a string', () => {
+      const id = generateId();
+      expect(typeof id).toBe('string');
+    });
+
+    it('should return an ID with default length of 24 characters', () => {
+      const id = generateId();
+      expect(id.length).toBe(24);
+    });
+
+    it('should only contain valid base64url characters (alphanumeric)', () => {
+      const id = generateId();
+      expect(id).toMatch(/^[A-Za-z0-9]+$/);
+    });
+
+    it('should generate unique IDs across multiple calls', () => {
+      const ids = new Set();
+      const iterations = 1000;
+
+      for (let i = 0; i < iterations; i++) {
+        ids.add(generateId());
+      }
+
+      expect(ids.size).toBe(iterations);
+    });
+
+    it('should not produce the same ID twice in rapid succession', () => {
+      const id1 = generateId();
+      const id2 = generateId();
+      expect(id1).not.toBe(id2);
+    });
+
+    it('should not contain +, /, or = characters', () => {
+      const id = generateId();
+      expect(id).not.toMatch(/[+/=]/);
+    });
+
+  });
+
+  describe('createCustomGenerator()', () => {
+
+    describe('basic functionality', () => {
+
+      it('should return a generator function', () => {
+        const generator = createCustomGenerator();
+        expect(typeof generator).toBe('function');
+      });
+
+      it('should generate IDs with default settings (no prefix)', () => {
+        const generator = createCustomGenerator();
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts.length).toBe(2);
+      });
+
+      it('should generate IDs with timestamp component', () => {
+        const generator = createCustomGenerator();
+        const id = generator({});
+
+        const parts = id.split('-');
+        const timestamp = parseInt(parts[0], 36);
+
+        expect(timestamp).toBeGreaterThan(0);
+        expect(timestamp).toBeLessThanOrEqual(Date.now().toString(36).length + 1000);
+      });
+
+      it('should generate IDs with random component of default length 8', () => {
+        const generator = createCustomGenerator();
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts[1].length).toBe(8);
+      });
+
+    });
+
+    describe('custom prefix support', () => {
+
+      it('should include custom prefix in generated ID', () => {
+        const generator = createCustomGenerator({ prefix: 'sess' });
+        const id = generator({});
+
+        expect(id.startsWith('sess-')).toBe(true);
+      });
+
+      it('should include custom prefix with timestamp and random parts', () => {
+        const generator = createCustomGenerator({ prefix: 'myapp' });
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts.length).toBe(3);
+        expect(parts[0]).toBe('myapp');
+      });
+
+      it('should support multiple different prefixes', () => {
+        const gen1 = createCustomGenerator({ prefix: 'admin' });
+        const gen2 = createCustomGenerator({ prefix: 'user' });
+
+        const id1 = gen1({});
+        const id2 = gen2({});
+
+        expect(id1.startsWith('admin-')).toBe(true);
+        expect(id2.startsWith('user-')).toBe(true);
+      });
+
+    });
+
+    describe('custom random length', () => {
+
+      it('should respect custom randomLength option', () => {
+        const generator = createCustomGenerator({ randomLength: 16 });
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts[parts.length - 1].length).toBe(16);
+      });
+
+      it('should work with very short random length (1)', () => {
+        const generator = createCustomGenerator({ randomLength: 1 });
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts[parts.length - 1].length).toBe(1);
+      });
+
+      it('should work with long random length (32)', () => {
+        const generator = createCustomGenerator({ randomLength: 32 });
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts[parts.length - 1].length).toBe(32);
+      });
+
+    });
+
+    describe('custom separator', () => {
+
+      it('should use custom separator when provided', () => {
+        const generator = createCustomGenerator({ separator: '_' });
+        const id = generator({});
+
+        expect(id).toContain('_');
+        expect(id).not.toContain('-');
+      });
+
+      it('should work with multi-character separator', () => {
+        const generator = createCustomGenerator({ separator: '::' });
+        const id = generator({});
+
+        expect(id).toContain('::');
+      });
+
+    });
+
+    describe('combined options', () => {
+
+      it('should support prefix, separator, and randomLength together', () => {
+        const generator = createCustomGenerator({
+          prefix: 'test',
+          separator: '|',
+          randomLength: 12
+        });
+        const id = generator({});
+
+        expect(id.startsWith('test|')).toBe(true);
+        const parts = id.split('|');
+        expect(parts.length).toBe(3);
+        expect(parts[2].length).toBe(12);
+      });
+
+    });
+
+  });
+
+  describe('edge cases and invalid inputs', () => {
+
+    describe('empty options', () => {
+
+      it('should handle empty object as options', () => {
+        const generator = createCustomGenerator({});
+        const id = generator({});
+
+        expect(typeof id).toBe('string');
+        expect(id.length).toBeGreaterThan(0);
+      });
+
+      it('should handle undefined as options', () => {
+        const generator = createCustomGenerator(undefined);
+        const id = generator({});
+
+        expect(typeof id).toBe('string');
+        expect(id.length).toBeGreaterThan(0);
+      });
+
+      it('should handle null as options', () => {
+        const generator = createCustomGenerator(null);
+        const id = generator({});
+
+        expect(typeof id).toBe('string');
+        expect(id.length).toBeGreaterThan(0);
+      });
+
+    });
+
+    describe('invalid inputs', () => {
+
+      it('should throw TypeError when options is a string', () => {
+        expect(() => createCustomGenerator('invalid')).toThrow(TypeError);
+        expect(() => createCustomGenerator('invalid')).toThrow('options must be an object');
+      });
+
+      it('should throw TypeError when options is a number', () => {
+        expect(() => createCustomGenerator(42)).toThrow(TypeError);
+        expect(() => createCustomGenerator(42)).toThrow('options must be an object');
+      });
+
+      it('should throw TypeError when options is a boolean', () => {
+        expect(() => createCustomGenerator(true)).toThrow(TypeError);
+        expect(() => createCustomGenerator(true)).toThrow('options must be an object');
+      });
+
+      it('should throw RangeError when randomLength is 0', () => {
+        expect(() => createCustomGenerator({ randomLength: 0 })).toThrow(RangeError);
+        expect(() => createCustomGenerator({ randomLength: 0 })).toThrow('randomLength must be at least 1');
+      });
+
+      it('should throw RangeError when randomLength is negative', () => {
+        expect(() => createCustomGenerator({ randomLength: -5 })).toThrow(RangeError);
+        expect(() => createCustomGenerator({ randomLength: -5 })).toThrow('randomLength must be at least 1');
+      });
+
+    });
+
+    describe('empty prefix', () => {
+
+      it('should handle empty string prefix', () => {
+        const generator = createCustomGenerator({ prefix: '' });
+        const id = generator({});
+
+        const parts = id.split('-');
+        expect(parts.length).toBe(2);
+        expect(parts[0]).toMatch(/^[0-9a-z]+$/);
+      });
+
+    });
+
+  });
+
+  describe('integration with express-session genid pattern', () => {
+
+    it('should work as genid function in session middleware pattern', () => {
+      const generator = createCustomGenerator({ prefix: 'sid' });
+
+      const mockReq = {
+        url: '/test',
+        headers: {}
+      };
+
+      const sessionId = generator(mockReq);
+
+      expect(typeof sessionId).toBe('string');
+      expect(sessionId.startsWith('sid-')).toBe(true);
+    });
+
+    it('should generate different IDs for different requests', () => {
+      const generator = createCustomGenerator({ prefix: 'session' });
+
+      const req1 = { url: '/page1', headers: {} };
+      const req2 = { url: '/page2', headers: {} };
+
+      const id1 = generator(req1);
+      const id2 = generator(req2);
+
+      expect(id1).not.toBe(id2);
+    });
+
+    it('should work with generateId as default genid', () => {
+      const mockReq = { url: '/', headers: {} };
+
+      const sessionId = generateId(mockReq);
+
+      expect(typeof sessionId).toBe('string');
+      expect(sessionId.length).toBe(24);
+    });
+
+    it('should maintain uniqueness under high concurrency simulation', () => {
+      const generator = createCustomGenerator({
+        prefix: 'loadtest',
+        randomLength: 16
+      });
+
+      const ids = new Set();
+      const iterations = 5000;
+
+      for (let i = 0; i < iterations; i++) {
+        const mockReq = { url: `/request/${i}`, headers: {} };
+        ids.add(generator(mockReq));
+      }
+
+      expect(ids.size).toBe(iterations);
+    });
+
+    it('should produce IDs compatible with session store expectations', () => {
+      const generator = createCustomGenerator({ prefix: 'express' });
+
+      for (let i = 0; i < 100; i++) {
+        const id = generator({});
+
+        expect(id).toMatch(/^express-[0-9a-z]+-[A-Za-z0-9]+$/);
+        expect(id.length).toBeGreaterThan(10);
+        expect(id.length).toBeLessThan(100);
+      }
+    });
+
+  });
+
+});
