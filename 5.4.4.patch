+/**
+ * MODIFIED: Custom generate session ID with format: SESSION-{timestamp}-{clientIP前8位哈希}-{randomBytes}
+ * Format: SESSION-{timestamp}-{clientIPHashPrefix}-{random}
+ * 使用 crypto.randomBytes 补足随机性确保唯一性，通过 req 获取客户端 IP
+ *
+ * @param {Object} req - Express request object
+ * @return {String} Custom formatted session ID
+ * @private
+ */
+
+function generateSessionIdCustom(req) {
+  var timestamp = Date.now();
+  var clientIP = getClientIP(req);
+  var ipHash = crypto.createHash('sha1').update(clientIP).digest('hex').slice(0, 8);
+  var randomBytes = crypto.randomBytes(16).toString('hex');
+  return 'SESSION-' + timestamp + '-' + ipHash + '-' + randomBytes;
+}
+
+/**
+ * MODIFIED: Helper to get client IP from request
+ * Extract client IP address considering X-Forwarded-For header and direct connection
+ *
+ * @param {Object} req - Express request object
+ * @return {String} Client IP address
+ * @private
+ */
+
+function getClientIP(req) {
+  var ip = req.ip ||
+          req.connection && req.connection.remoteAddress ||
+          req.socket && req.socket.remoteAddress ||
+          req.connection && req.connection.socket && req.connection.socket.remoteAddress ||
+          'unknown';
+
+  if (Array.isArray(req.ips) && req.ips.length) {
+    ip = req.ips[0];
+  }
+
+  return ip;
+}
