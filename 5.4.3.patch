+const session = require('express-session');
+const crypto = require('crypto');
+
+/**
+ * 自定义 Session ID 生成器
+ * 格式: SESSION-{timestamp}-{clientIP前8位哈希}-{randomHex}
+ * @param {Object} req - Express request 对象
+ * @returns {string} 自定义的 Session ID
+ */
+const customGenId = (req) => {
+  // 1. 获取当前时间戳
+  const timestamp = Date.now();
+  
+  // 2. 获取客户端 IP (支持反向代理)
+  const clientIP = req.headers['x-forwarded-for'] || req.socket?.remoteAddress || 'unknown';
+  
+  // 3. 计算客户端 IP 的前 8 位哈希
+  const ipHash = crypto.createHash('sha256').update(clientIP).digest('hex').substring(0, 8);
+  
+  // 4. 使用 crypto.randomBytes 生成随机字符，补足随机性，确保唯一性
+  const randomHex = crypto.randomBytes(8).toString('hex');
+  
+  // 5. 拼接生成最终的 Session ID
+  return `SESSION-${timestamp}-${ipHash}-${randomHex}`;
+};
+
+// express-session 配置对象
+const sessionConfig = {
+  secret: process.env.SESSION_SECRET || 'default_secret_key', // 建议通过环境变量配置
+  resave: false,
+  saveUninitialized: true,
+  genid: customGenId, // 【改动点】集成自定义会话 ID 生成器，提升业务可读性与安全性
+  cookie: {
+    secure: process.env.NODE_ENV === 'production',
+    maxAge: 24 * 60 * 60 * 1000 // 默认 1 天
+  }
+};
+
+module.exports = sessionConfig;
