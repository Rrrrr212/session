diff --git a/src/middlewares/session.js b/src/middlewares/session.js
new file mode 100644
index 0000000..243b722
--- /dev/null
+++ b/src/middlewares/session.js
@@ -0,0 +1,140 @@
+'use strict'
+
+var crypto = require('crypto')
+var cookie = require('cookie')
+var signature = require('cookie-signature')
+var session = require('express-session')
+
+var SESSION_COOKIE_NAME = 'connect.sid'
+var SESSION_SECRET = process.env.SESSION_SECRET || 'xxx'
+var SESSION_ID_PATTERN = /^[A-Za-z0-9-]+_[0-9]{13}_[a-f0-9]{16}$/
+
+function sanitizeUserId(userId) {
+  var normalized = String(userId || 'guest').replace(/[^A-Za-z0-9-]/g, '-')
+
+  if (!normalized) {
+    return 'guest'
+  }
+
+  return normalized.slice(0, 64)
+}
+
+function resolveUserId(req) {
+  if (req.user) {
+    return req.user.id || req.user.userId || req.user.username || req.user.email
+  }
+
+  if (req.body) {
+    return req.body.userId || req.body.id || req.body.username
+  }
+
+  if (req.session && req.session.user) {
+    if (typeof req.session.user === 'string' || typeof req.session.user === 'number') {
+      return req.session.user
+    }
+
+    if (typeof req.session.user === 'object') {
+      return req.session.user.id || req.session.user.userId || req.session.user.username || req.session.user.email
+    }
+  }
+
+  return 'guest'
+}
+
+function createSessionId(req) {
+  var userId = sanitizeUserId(resolveUserId(req))
+  var timestamp = Date.now()
+  var random = crypto.randomBytes(8).toString('hex')
+  var sessionId = [userId, timestamp, random].join('_')
+
+  console.info('[session][genid]', JSON.stringify({
+    stage: 'generate',
+    userId: userId,
+    sessionId: sessionId,
+    path: req.originalUrl || req.url
+  }))
+
+  return sessionId
+}
+
+function parseCookieSessionId(req) {
+  var cookieHeader = req.headers && req.headers.cookie
+  var parsedCookie
+  var rawCookie
+  var decodedCookie
+  var unsignedSessionId
+
+  if (!cookieHeader) {
+    return undefined
+  }
+
+  parsedCookie = cookie.parse(cookieHeader)
+  rawCookie = parsedCookie[SESSION_COOKIE_NAME]
+
+  if (!rawCookie) {
+    return undefined
+  }
+
+  decodedCookie = decodeURIComponent(rawCookie)
+
+  if (decodedCookie.indexOf('s:') !== 0) {
+    return undefined
+  }
+
+  unsignedSessionId = signature.unsign(decodedCookie.slice(2), SESSION_SECRET)
+
+  return unsignedSessionId || undefined
+}
+
+function isValidSessionId(sessionId) {
+  return typeof sessionId === 'string' && SESSION_ID_PATTERN.test(sessionId)
+}
+
+var baseSessionMiddleware = session({
+  secret: SESSION_SECRET,
+  resave: false,
+  saveUninitialized: false,
+  genid: createSessionId
+})
+
+module.exports = function sessionMiddleware(req, res, next) {
+  var cookieSessionId = parseCookieSessionId(req)
+
+  console.info('[session][incoming]', JSON.stringify({
+    stage: 'incoming',
+    cookieSessionId: cookieSessionId,
+    cookieSessionIdValid: isValidSessionId(cookieSessionId),
+    path: req.originalUrl || req.url
+  }))
+
+  baseSessionMiddleware(req, res, function (err) {
+    var sessionUser
+
+    if (err) {
+      return next(err)
+    }
+
+    sessionUser = req.session ? req.session.user || null : null
+
+    console.info('[session][validate]', JSON.stringify({
+      stage: 'validate',
+      cookieSessionId: cookieSessionId,
+      currentSessionId: req.sessionID,
+      cookieMatchesSession: !cookieSessionId || cookieSessionId === req.sessionID,
+      currentSessionIdValid: isValidSessionId(req.sessionID),
+      sessionUser: sessionUser,
+      path: req.originalUrl || req.url
+    }))
+
+    if (req.session && typeof req.session.user === 'undefined') {
+      console.warn('[session][user-missing]', JSON.stringify({
+        stage: 'missing-user',
+        cookieSessionId: cookieSessionId,
+        currentSessionId: req.sessionID,
+        path: req.originalUrl || req.url
+      }))
+    }
+
+    next()
+  })
+}
