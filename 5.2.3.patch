+/**
+ * idGenerator.js
+ * 
+ * 设计模式说明：
+ * 1. 策略模式 (Strategy Pattern)：将 ID 生成的具体算法封装起来，使它们可以互相替换。
+ *    这里将默认的随机字符串生成作为基础策略。
+ * 2. 工厂模式/高阶函数 (Factory / Higher-Order Function)：通过 `createCustomGenerator` 
+ *    提供一个工厂方法，接收外部传入的自定义生成策略（控制反转，类似 express-session 的 genid 配置），
+ *    返回一个封装好的生成器函数，提高了代码的灵活性和可扩展性。
+ */
+
+const crypto = require('crypto');
+
+/**
+ * 默认的 ID 生成逻辑
+ * 采用随机字符串实现，保留原有逻辑
+ * 
+ * @returns {string} 随机生成的唯一 ID
+ */
+function generateId() {
+  // 这里使用 crypto 生成随机字符串作为默认实现
+  return crypto.randomBytes(16).toString('hex');
+}
+
+/**
+ * 高阶函数：创建自定义 ID 生成器
+ * 允许传入自定义规则函数（如：prefix + timestamp + random）
+ * 
+ * @param {Function} rule - 接收生成规则函数，该函数应返回一个字符串
+ * @returns {Function} 返回一个自定义的生成器函数
+ */
+function createCustomGenerator(rule) {
+  if (typeof rule !== 'function') {
+    throw new TypeError('规则必须是一个函数');
+  }
+
+  // 返回一个新的生成器函数
+  return function customGenerator(...args) {
+    return rule(...args);
+  };
+}
+
+module.exports = {
+  generateId,
+  createCustomGenerator
+};
