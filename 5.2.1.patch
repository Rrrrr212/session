diff --git a/src/utils/idGenerator.js b/src/utils/idGenerator.js
new file mode 100644
index 0000000..1c377e5
--- /dev/null
+++ b/src/utils/idGenerator.js
@@ -0,0 +1,84 @@
+'use strict';
+
+/**
+ * ID Generator Module
+ * 采用工厂模式和策略模式设计，支持自定义唯一ID生成规则
+ * 
+ * 设计模式说明：
+ * - 工厂模式：createCustomGenerator 高阶函数作为工厂，根据规则创建不同的生成器
+ * - 策略模式：不同的生成规则作为可互换的策略
+ */
+
+var uid = require('uid-safe').sync;
+
+/**
+ * 默认 ID 生成函数
+ * 保留原有的随机字符串实现
+ * 
+ * @return {String} 生成的唯一ID
+ */
+function generateId() {
+  return uid(24);
+}
+
+/**
+ * 创建自定义 ID 生成器的高阶函数
+ * 
+ * @param {Object|Function} rule 自定义生成规则
+ *   - 如果是函数：直接作为生成器函数
+ *   - 如果是对象：支持以下属性组合
+ *     @param {String} [prefix] 前缀
+ *     @param {String} [suffix] 后缀
+ *     @param {Boolean} [timestamp] 是否包含时间戳
+ *     @param {Boolean} [random] 是否包含随机字符串
+ *     @param {String} [separator='-'] 分隔符
+ * @return {Function} 自定义的 ID 生成器函数
+ * 
+ * @example
+ * // 使用对象配置
+ * const customGen = createCustomGenerator({
+ *   prefix: 'sess',
+ *   timestamp: true,
+ *   random: true
+ * });
+ * 
+ * // 使用自定义函数
+ * const customGen = createCustomGenerator(() => 'custom_' + Date.now());
+ */
+function createCustomGenerator(rule) {
+  if (typeof rule === 'function') {
+    return rule;
+  }
+
+  var config = rule || {};
+  var separator = config.separator || '-';
+
+  return function customGenerateId() {
+    var parts = [];
+
+    if (config.prefix) {
+      parts.push(String(config.prefix));
+    }
+
+    if (config.timestamp) {
+      parts.push(Date.now().toString());
+    }
+
+    if (config.random !== false) {
+      parts.push(uid(16));
+    }
+
+    if (config.suffix) {
+      parts.push(String(config.suffix));
+    }
+
+    if (parts.length === 0) {
+      return uid(24);
+    }
+
+    return parts.join(separator);
+  };
+}
+
+exports.generateId = generateId;
+exports.createCustomGenerator = createCustomGenerator;
